#!/bin/sh /etc/rc.common
# WESHAH agent: REST API (uhttpd CGI, LAN only) + reconcile ticker, both under procd.

START=99
STOP=10
USE_PROCD=1

CONF=/etc/weshah-agent.conf
WWW=/usr/lib/weshah-agent/www

ensure_conf() {
    local gen
    [ -f "$CONF" ] || printf 'PORT=8765\nTOKEN=\n' > "$CONF"
    chmod 600 "$CONF"
    # shellcheck disable=SC1090
    . "$CONF"
    if [ "${#TOKEN}" -lt 32 ]; then
        # 256 bits from the kernel RNG. Never fall back to something guessable: refuse to start instead.
        gen=$(head -c 32 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
        if [ "${#gen}" -ne 64 ]; then
            logger -t weshah-agent "cannot read /dev/urandom: refusing to start without a secret token"
            return 1
        fi
        TOKEN="$gen"
        grep -v '^TOKEN=' "$CONF" > "$CONF.new"
        echo "TOKEN=$TOKEN" >> "$CONF.new"
        chmod 600 "$CONF.new"
        mv "$CONF.new" "$CONF"
    fi
    PORT="${PORT:-8765}"
}

start_service() {
    local lanip
    ensure_conf || return 1
    mkdir -p /etc/weshah-agent /tmp/weshah-agent
    lanip=$(uci -q get network.lan.ipaddr)
    lanip=${lanip%%/*}

    procd_open_instance api
    procd_set_param command /usr/sbin/uhttpd -f -h "$WWW" -x /api \
        -p "127.0.0.1:$PORT" -p "${lanip:-0.0.0.0}:$PORT" \
        -t 120 -T 30 -N 12 -n 4 -D -S
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance ticker
    procd_set_param command /usr/sbin/weshah-agent-ticker
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger network
}
