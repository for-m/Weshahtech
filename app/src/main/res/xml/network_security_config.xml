<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext traffic only to local/private IP ranges (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
  Public internet traffic is always HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Common router local subnets -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.254</domain>
        <domain includeSubdomains="false">172.16.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
