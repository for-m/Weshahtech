<?xml version="1.0" encoding="utf-8"?>
<!--
  Android cannot express "private address ranges" here (only exact domains), so cleartext is permitted at
  the platform level and RESTRICTED IN CODE: OpenWrtAdapter refuses plain HTTP to any host that is not a
  private/link-local/loopback IP literal (see NetworkGuard, covered by unit tests). HTTPS is unaffected.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
